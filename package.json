{
  "name": "gaokao-artifact-local-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "game:data": "tsx gh_pages_local_game/scripts/buildArtifactsData.ts",
    "game:dev": "npm run game:data --silent && vite --config gh_pages_local_game/vite.config.ts",
    "game:build": "npm run game:data --silent && vite build --config gh_pages_local_game/vite.config.ts",
    "game:preview": "vite preview --config gh_pages_local_game/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.3"
  }
}
